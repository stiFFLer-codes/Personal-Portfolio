---
import Nav from '../components/Nav.astro';
import StatusLedger from '../components/StatusLedger.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';

// Self-hosted so no render-blocking request leaves for a third-party CDN.
//
// Two families only. Newsreader does display and body; the mono does
// everything mechanical. Both are the weight-axis-only builds — the
// multi-axis files carry an optical-size axis this site does not use and
// cost roughly twice the bytes.
//
// The italic import is separate and deliberate: Newsreader's normal build
// ships no italic faces at all, and `.prose blockquote` is italic. Do not
// tidy it away.
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Static card, regenerated from scripts/og-image.html.
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Maitreya Sapariya: I build software systems that turn messy, real-world data into decisions people can act on."
    />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="sr-only-focusable" href="#main">Skip to content</a>
    <Nav />
    <StatusLedger />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
