---
// A small colored dot. `status` accepts either the project vocabulary
// (shipped / in-progress / planned) or the log vocabulary (ship / progress /
// note) — both map to the same three colors on purpose, so the whole site
// reads as one status language.
//
// The dot is always decorative: a text label saying the same thing sits
// next to it everywhere it is used. Color never carries meaning alone.
interface Props {
  status: 'shipped' | 'in-progress' | 'planned' | 'ship' | 'progress' | 'note';
}
const { status } = Astro.props;
---

<span class={`dot dot-${status}`} aria-hidden="true"></span>
