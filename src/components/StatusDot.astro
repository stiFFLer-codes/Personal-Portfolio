---
// A small coloured dot: green for done, amber for moving, slate for planned
// or archived.
//
// The dot is always decorative: a word saying the same thing sits next to it
// everywhere it is used. Colour never carries meaning alone.
interface Props {
  status: 'shipped' | 'in-progress' | 'planned' | 'archived';
}
const { status } = Astro.props;
---

<span class={`dot dot-${status}`} aria-hidden="true"></span>
