---
// The travel plate: a survey map of northern Europe with the Aug 2025 trip
// traced across it. Coastlines and lakes are accurate Natural Earth
// (public-domain) geometry, projected (Lambert conformal conic) and baked into
// travel-geo.ts at build time — no map library, no runtime request. Each
// country is its own path, so real borders read. Markers and route are
// generated from the `places` collection, projected through the same transform
// so every pin lands in the right country.
//
// The map furniture (title, legend, stop index) lives OUTSIDE the plate as
// marginalia in the page — the plate itself carries only what belongs on a map.
//
// The inline script (documented carve-out, see CLAUDE.md) adds multi-layer
// pointer-parallax and route-leg glow. Pure enhancement.
import type { CollectionEntry } from 'astro:content';
// Note: the generator also emits COUNTRY_LABELS (raw largest-ring centroids),
// but those aren't imported on purpose — a centroid sits badly for a concave
// country (Norway's lands offshore, Sweden's mid-water), so the label anchors
// below are hand-placed for legibility and verified against the rendered plate.
import {
  VIEW,
  KM_PER_PX,
  COUNTRIES,
  LAKES,
  GRATICULE,
  CITY_COORDS,
} from './travel-geo';

interface Props {
  places: CollectionEntry<'places'>[];
}
const { places } = Astro.props;

const VW = VIEW.w;
const VH = VIEW.h;
const coordFor = (id: string) => CITY_COORDS[id.replace(/^\d+-/, '')] ?? '';

const stops = [...places]
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    id: p.id,
    order: p.data.order,
    name: p.data.name,
    country: p.data.country,
    dateLabel: p.data.dateLabel,
    blurb: p.data.blurb,
    anchor: p.data.anchor,
    coord: coordFor(p.id),
    x: p.data.x,
    y: p.data.y,
    px: (p.data.x / 100) * VW,
    py: (p.data.y / 100) * VH,
    toLeft: p.data.x > 52,
    toUp: p.data.y > 60,
  }));

const legs = stops.slice(1).map((to, i) => {
  const from = stops[i];
  return { i, to, anchor: to.anchor, d: `M ${from.px} ${from.py} L ${to.px} ${to.py}` };
});

const routePathD =
  'M ' + stops.map((s) => `${s.px.toFixed(1)} ${s.py.toFixed(1)}`).join(' L ');

const countryLabels = [
  { name: 'NORWAY', x: 175, y: 250 },
  { name: 'SWEDEN', x: 455, y: 250 },
  { name: 'FINLAND', x: 790, y: 118 },
  { name: 'DENMARK', x: 205, y: 505 },
  { name: 'ESTONIA', x: 820, y: 352 },
  { name: 'LATVIA', x: 822, y: 505 },
];
const waterLabels = [
  { t: 'NORTH SEA', x: 118, y: 470, cls: 'map-water-sm' },
  { t: 'BALTIC SEA', x: 545, y: 520, cls: 'map-water' },
];

const scaleKm = 200;
const scalePx = scaleKm / KM_PER_PX;
---

<figure class="plate" data-plate>
  <div class="plate-inner">
    <svg
      class="plate-map"
      data-depth="3"
      viewBox={`0 0 ${VW} ${VH}`}
      role="img"
      aria-labelledby="plate-title plate-desc"
    >
      <title id="plate-title">Map of northern Europe</title>
      <desc id="plate-desc">
        Norway, Sweden, Finland, Denmark, Estonia and Latvia around the Baltic
        Sea, with lakes, and the route of the August 2025 trip traced between
        its stops. The same stops are listed as text below the map.
      </desc>

      <defs>
        <pattern
          id="land-hatch"
          width="7"
          height="7"
          patternUnits="userSpaceOnUse"
          patternTransform="rotate(45)"
        >
          <line class="hatch-line" x1="0" y1="0" x2="0" y2="7" />
        </pattern>
        <mask id="sea-mask">
          <rect x="0" y="0" width={VW} height={VH} fill="white" />
          {COUNTRIES.map((c) => <path d={c.d} fill="black" />)}
        </mask>
      </defs>

      <!-- Graticule, masked to the sea only -->
      <g class="graticule" mask="url(#sea-mask)" aria-hidden="true">
        {GRATICULE.map((d) => <path d={d} />)}
      </g>

      <!-- Engraved water-lines behind the coasts -->
      <g aria-hidden="true">
        {COUNTRIES.map((c) => <path class="map-halo" d={c.d} />)}
        {COUNTRIES.map((c) => <path class="map-halo2" d={c.d} />)}
      </g>

      <!-- Land: base fill, engraved hatch, then lakes cut back to water -->
      <g aria-hidden="true">
        {COUNTRIES.map((c) => <path class="map-land" d={c.d} />)}
        {COUNTRIES.map((c) => <path class="map-hatch" d={c.d} />)}
        {LAKES.map((d) => <path class="map-lake" d={d} />)}
      </g>

      <!-- Labels, with a paper knockout halo so they read over the terrain -->
      <g class="map-labels" aria-hidden="true">
        {countryLabels.map((l) => (
          <text class="map-country" x={l.x} y={l.y}>{l.name}</text>
        ))}
        <text
          class="map-water map-water-v"
          x="588"
          y="205"
          transform="rotate(-90 588 205)">GULF OF BOTHNIA</text>
        {waterLabels.map((w) => (
          <text class:list={['map-water', w.cls]} x={w.x} y={w.y}>{w.t}</text>
        ))}
      </g>

      <!-- Compass rose -->
      <g class="doodle" transform="translate(108 116)" aria-hidden="true">
        <circle r="28" />
        <circle r="20" class="doodle-thin" />
        <circle r="3" class="doodle-fill" />
        <path d="M 0 -38 L 6 -5 L 0 -24 L -6 -5 Z" class="doodle-fill" />
        <path d="M 0 38 L 6 5 L 0 24 L -6 5 Z" />
        <path d="M -38 0 L -5 -6 L -24 0 L -5 6 Z" />
        <path d="M 38 0 L 5 -6 L 24 0 L 5 6 Z" />
        <text class="doodle-n" x="0" y="-43">N</text>
      </g>

      <!-- Scale bar -->
      <g class="scalebar" transform="translate(44 640)" aria-hidden="true">
        <path class="doodle-thin" d={`M 0 0 H ${scalePx.toFixed(1)}`} />
        <path class="doodle-thin" d="M 0 -4 V 4" />
        <path class="doodle-thin" d={`M ${scalePx.toFixed(1)} -4 V 4`} />
        <path class="doodle-thin" d={`M ${(scalePx / 2).toFixed(1)} -3 V 3`} />
        <text class="scalebar-text" x={(scalePx / 2).toFixed(1)} y="16">{scaleKm} km</text>
      </g>

      <!-- Route legs, drawn between stops in travel order -->
      <g class="route" aria-hidden="true">
        {legs.map((leg) => (
          <path
            class:list={['route-leg', { 'anchor-leg': leg.anchor }]}
            id={`leg-${leg.to.order}`}
            d={leg.d}
            pathLength="1"
            style={`--leg-i:${leg.i}`}
          />
        ))}
        <circle class="route-token" r="3.4" cx="0" cy="0" style={`offset-path: path('${routePathD}')`}></circle>
      </g>

      <!-- Neat-line: an inner ruled border with corner ticks -->
      <g class="neatline" aria-hidden="true">
        <rect x="7" y="7" width={VW - 14} height={VH - 14} />
        <path d={`M 7 26 V 7 H 26 M ${VW - 26} 7 H ${VW - 7} V 26 M 7 ${VH - 26} V ${VH - 7} H 26 M ${VW - 26} ${VH - 7} H ${VW - 7} V ${VH - 26}`} class="neatline-ticks" />
      </g>
    </svg>

    <!-- Markers: real links on top of the map, one per stop -->
    <ul class="plate-stops" data-depth="7">
      {stops.map((s) => (
        <li>
          <a
            class:list={[
              'stop',
              { 'is-anchor': s.anchor, 'to-left': s.toLeft, 'to-up': s.toUp },
            ]}
            href={`#stop-${s.id}`}
            data-leg={s.order}
            style={`left:${s.x}%;top:${s.y}%;--i:${s.order}`}
            aria-label={`${s.name}, ${s.country}, ${s.dateLabel}. Jump to details below.`}
          >
            <span class="stop-dot" aria-hidden="true"></span>
            <span class="stop-name mono" aria-hidden="true">
              {s.name}
              {s.anchor && <span class="stop-tag">summer school</span>}
            </span>
            <span class="specimen-card" aria-hidden="true">
              <span class="specimen-card-name">{s.name}</span>
              <span class="specimen-card-meta mono">{s.country} · {s.dateLabel}</span>
              {s.coord && <span class="specimen-card-coord mono">{s.coord}</span>}
              <span class="specimen-card-blurb">{s.blurb}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</figure>

<script>
  // Documented carve-out (see CLAUDE.md): multi-layer pointer-parallax + route
  // leg glow. Pure enhancement — everything works without it.
  var plate = document.querySelector('[data-plate]');
  if (plate && window.matchMedia) {
    var layers = plate.querySelectorAll('[data-depth]');
    var fine = matchMedia('(hover: hover) and (pointer: fine)');
    var motionOK = matchMedia('(prefers-reduced-motion: no-preference)');

    if (layers.length && fine.matches && motionOK.matches) {
      plate.addEventListener('pointermove', function (e) {
        var r = plate.getBoundingClientRect();
        var dx = (e.clientX - r.left) / r.width - 0.5;
        var dy = (e.clientY - r.top) / r.height - 0.5;
        layers.forEach(function (el) {
          var f = parseFloat(el.getAttribute('data-depth')) || 0;
          el.style.transform =
            'translate(' + (dx * -f).toFixed(2) + 'px,' + (dy * -f).toFixed(2) + 'px)';
        });
      });
      plate.addEventListener('pointerleave', function () {
        layers.forEach(function (el) { el.style.transform = ''; });
      });
    }

    var markers = plate.querySelectorAll('[data-leg]');
    markers.forEach(function (m) {
      var leg = plate.querySelector('#leg-' + m.getAttribute('data-leg'));
      if (!leg) return;
      var on = function () { leg.classList.add('is-lit'); };
      var off = function () { leg.classList.remove('is-lit'); };
      m.addEventListener('pointerenter', on);
      m.addEventListener('pointerleave', off);
      m.addEventListener('focus', on);
      m.addEventListener('blur', off);
    });
  }
</script>
