---
// The travel plate: a survey map of northern Europe with the Aug 2025 trip
// traced across it. Coastlines are accurate Natural Earth (public-domain)
// boundaries, projected (Lambert conformal conic) and baked into travel-geo.ts
// at build time — no map library, no runtime request. Each country is its own
// path, so real borders read (Norway|Sweden, Estonia|Latvia). Route legs and
// markers are generated from the `places` collection, projected through the
// same transform so every pin lands in the right country.
//
// The one small inline script below is a documented carve-out (see CLAUDE.md):
// bounded pointer-parallax + route-leg glow. Pure enhancement — with no JS the
// map still renders, the route still draws, hovering still shows each card, and
// every marker still links to its field-log entry.
import type { CollectionEntry } from 'astro:content';
import { VIEW, KM_PER_PX, COUNTRIES, COUNTRY_LABELS } from './travel-geo';

interface Props {
  places: CollectionEntry<'places'>[];
}
const { places } = Astro.props;

const VW = VIEW.w;
const VH = VIEW.h;

const stops = [...places]
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    id: p.id,
    order: p.data.order,
    name: p.data.name,
    country: p.data.country,
    dateLabel: p.data.dateLabel,
    blurb: p.data.blurb,
    anchor: p.data.anchor,
    x: p.data.x,
    y: p.data.y,
    px: (p.data.x / 100) * VW,
    py: (p.data.y / 100) * VH,
    toLeft: p.data.x > 52,
    toUp: p.data.y > 60,
  }));

const legs = stops.slice(1).map((to, i) => {
  const from = stops[i];
  return { i, to, anchor: to.anchor, d: `M ${from.px} ${from.py} L ${to.px} ${to.py}` };
});

// Country label positions (centroids are unreliable for concave shapes like
// Norway, so these are placed by hand over each landmass).
const countryLabels = [
  { name: 'NORWAY', x: 180, y: 250 },
  { name: 'SWEDEN', x: 455, y: 250 },
  { name: 'FINLAND', x: 775, y: 120 },
  { name: 'DENMARK', x: 205, y: 505 },
  { name: 'ESTONIA', x: 818, y: 352 },
  { name: 'LATVIA', x: 820, y: 505 },
];
const waterLabels = [
  { t: 'NORTH SEA', x: 120, y: 470, cls: 'map-water-sm' },
  { t: 'BALTIC SEA', x: 545, y: 505, cls: 'map-water' },
];

const scaleKm = 200;
const scalePx = scaleKm / KM_PER_PX;
---

<figure class="plate" data-plate>
  <figcaption class="plate-tag mono">
    <span>the north</span>
    <span aria-hidden="true">·</span>
    <span>august '25</span>
  </figcaption>

  <div class="plate-inner" data-plate-inner>
    <svg
      class="plate-map"
      viewBox={`0 0 ${VW} ${VH}`}
      role="img"
      aria-labelledby="plate-title plate-desc"
    >
      <title id="plate-title">Map of northern Europe</title>
      <desc id="plate-desc">
        Norway, Sweden, Finland, Denmark, Estonia and Latvia around the Baltic
        Sea, with the route of the August 2025 trip traced between its stops.
        The same stops are listed as text below the map.
      </desc>

      <!-- Engraved water-lines: coastline echoed twice behind the land -->
      <g aria-hidden="true">
        {COUNTRIES.map((c) => <path class="map-halo" d={c.d} />)}
        {COUNTRIES.map((c) => <path class="map-halo2" d={c.d} />)}
      </g>

      <!-- Land: each country its own shape, so borders read -->
      <g aria-hidden="true">
        {COUNTRIES.map((c) => <path class="map-land" d={c.d} />)}
      </g>

      <!-- Labels -->
      <g aria-hidden="true">
        {countryLabels.map((l) => (
          <text class="map-country" x={l.x} y={l.y}>{l.name}</text>
        ))}
        <text
          class="map-water map-water-v"
          x="588"
          y="205"
          transform="rotate(-90 588 205)">GULF OF BOTHNIA</text>
        {waterLabels.map((w) => (
          <text class:list={['map-water', w.cls]} x={w.x} y={w.y}>{w.t}</text>
        ))}
      </g>

      <!-- Compass rose, top-left ocean -->
      <g class="doodle" transform="translate(112 120)" aria-hidden="true">
        <circle r="30" />
        <circle r="22" class="doodle-thin" />
        <circle r="3" class="doodle-fill" />
        <path d="M 0 -40 L 7 -5 L 0 -26 L -7 -5 Z" class="doodle-fill" />
        <path d="M 0 40 L 7 5 L 0 26 L -7 5 Z" />
        <path d="M -40 0 L -5 -7 L -26 0 L -5 7 Z" />
        <path d="M 40 0 L 5 -7 L 26 0 L 5 7 Z" />
        <text class="doodle-n" x="0" y="-45">N</text>
      </g>

      <!-- Scale bar, bottom-left -->
      <g class="scalebar" transform="translate(44 648)" aria-hidden="true">
        <path class="doodle-thin" d={`M 0 0 H ${scalePx.toFixed(1)}`} />
        <path class="doodle-thin" d="M 0 -4 V 4" />
        <path class="doodle-thin" d={`M ${scalePx.toFixed(1)} -4 V 4`} />
        <path class="doodle-thin" d={`M ${(scalePx / 2).toFixed(1)} -3 V 3`} />
        <text class="scalebar-text" x={(scalePx / 2).toFixed(1)} y="16">{scaleKm} km</text>
      </g>

      <!-- Doodle: a whale in the open Baltic -->
      <g class="doodle" transform="translate(545 560)" aria-hidden="true">
        <path d="M 0 4 C 18 -12 60 -12 84 0 C 100 8 112 4 122 -4 C 116 12 100 18 82 14 C 58 26 18 24 0 10 C -6 8 -6 6 0 4 Z" />
        <path class="doodle-thin" d="M 24 -4 C 26 -14 32 -18 38 -20" />
        <circle cx="16" cy="4" r="1.6" class="doodle-fill" />
      </g>
      <path class="doodle doodle-thin" d="M 470 600 C 490 592 510 608 530 600" aria-hidden="true" />
      <path class="doodle doodle-thin" d="M 470 616 C 490 608 510 624 530 616" aria-hidden="true" />

      <!-- Route legs, drawn between stops in travel order -->
      <g class="route" aria-hidden="true">
        {legs.map((leg) => (
          <path
            class:list={['route-leg', { 'anchor-leg': leg.anchor }]}
            id={`leg-${leg.to.order}`}
            d={leg.d}
            pathLength="1"
            style={`--leg-i:${leg.i}`}
          />
        ))}
      </g>
    </svg>

    <!-- Markers: real links on top of the map, one per stop -->
    <ul class="plate-stops">
      {stops.map((s) => (
        <li>
          <a
            class:list={[
              'stop',
              { 'is-anchor': s.anchor, 'to-left': s.toLeft, 'to-up': s.toUp },
            ]}
            href={`#stop-${s.id}`}
            data-leg={s.order}
            style={`left:${s.x}%;top:${s.y}%;--i:${s.order}`}
            aria-label={`${s.name}, ${s.country}, ${s.dateLabel}. Jump to details below.`}
          >
            <span class="stop-dot" aria-hidden="true"></span>
            <span class="stop-name mono" aria-hidden="true">
              {s.name}
              {s.anchor && <span class="stop-tag">summer school</span>}
            </span>
            <span class="specimen-card" aria-hidden="true">
              <span class="specimen-card-name">{s.name}</span>
              <span class="specimen-card-meta mono">{s.country} · {s.dateLabel}</span>
              <span class="specimen-card-blurb">{s.blurb}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</figure>

<script>
  // Documented carve-out (see CLAUDE.md): pointer-parallax + route-leg glow.
  // Pure enhancement — everything works without it.
  var plate = document.querySelector('[data-plate]');
  if (plate && window.matchMedia) {
    var inner = plate.querySelector('[data-plate-inner]');
    var fine = matchMedia('(hover: hover) and (pointer: fine)');
    var motionOK = matchMedia('(prefers-reduced-motion: no-preference)');

    if (inner && fine.matches && motionOK.matches) {
      plate.addEventListener('pointermove', function (e) {
        var r = plate.getBoundingClientRect();
        var dx = (e.clientX - r.left) / r.width - 0.5;
        var dy = (e.clientY - r.top) / r.height - 0.5;
        inner.style.transform =
          'translate(' + (dx * -6).toFixed(2) + 'px,' + (dy * -6).toFixed(2) + 'px)';
      });
      plate.addEventListener('pointerleave', function () {
        inner.style.transform = '';
      });
    }

    var markers = plate.querySelectorAll('[data-leg]');
    markers.forEach(function (m) {
      var leg = plate.querySelector('#leg-' + m.getAttribute('data-leg'));
      if (!leg) return;
      var on = function () { leg.classList.add('is-lit'); };
      var off = function () { leg.classList.remove('is-lit'); };
      m.addEventListener('pointerenter', on);
      m.addEventListener('pointerleave', off);
      m.addEventListener('focus', on);
      m.addEventListener('blur', off);
    });
  }
</script>
