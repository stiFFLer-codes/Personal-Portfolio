---
// One of the three states a claim can be in, as a shape and a word. The
// shape is decorative; the word carries the meaning, so colour never does it
// alone.
import { STATE_WORD, type State } from '../ledger';

interface Props {
  state: State;
  /** Override the word, e.g. a count: "19 checkable". */
  label?: string;
}
const { state, label } = Astro.props;
---

<span class={`state state-${state}`}>
  <span class={`mark mark-${state}`} aria-hidden="true"></span>{label ?? STATE_WORD[state]}
</span>
