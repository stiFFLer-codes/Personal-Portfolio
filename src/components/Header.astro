---
const navItems = [{ href: '/about/', label: 'About' }];

const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const current = normalize(Astro.url.pathname);
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-2xl items-baseline justify-between px-6 py-4">
    <a href="/" class="font-heading text-base font-semibold text-ink">Maitreya Sapariya</a>
    <nav aria-label="Site">
      <ul class="flex gap-6">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.href ? 'page' : undefined}
                class:list={[
                  'text-sm underline-offset-4 hover:text-ink hover:underline',
                  current === item.href ? 'text-ink underline decoration-line' : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
