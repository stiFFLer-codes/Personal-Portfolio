---
// The checkable artifacts for a project or a paper. With nothing to link it
// shows `note` instead (say, "the source code is private"), and with neither
// it renders nothing, so an entry does not show an empty heading.
const LABELS: Record<string, string> = {
  repo: 'repository',
  live: 'live site',
  preprint: 'preprint',
  arxiv: 'arXiv',
  code: 'code',
  doi: 'doi',
};

interface Props {
  links: Record<string, string | undefined>;
  note?: string;
}
const { links, note } = Astro.props;

const entries = Object.entries(links).filter(([, url]) => Boolean(url)) as [
  string,
  string,
][];
---

{entries.length === 0 && note && (
  <section class="sources">
    <h2>sources</h2>
    <p class="sources-note">{note}</p>
  </section>
)}

{entries.length > 0 && (
  <section class="sources">
    <h2>sources</h2>
    <ul>
      {entries.map(([key, url]) => (
        <li>
          <a href={url} target="_blank" rel="noopener">
            {LABELS[key] ?? key} ↗
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
