---
// One row in any list on the site: papers, systems, jobs, study. Two
// columns: a mono margin on the left that says what stage the thing is at
// ("published", "archived") or when it happened ("Jan 2026 – now"); the
// content on the right. The row ends with its links, if it has any.
//
// This is the only place list rows are described. Change the shape of a
// listing here and every page that lists anything follows.
import Todo from './Todo.astro';
import { SHOW_TODOS } from '../todo';
import { LINK_LABELS, presentLinks } from '../links';

interface Props {
  title: string;
  /** The margin word or date. */
  label: string;
  /** Set when `label` is a date, so it is machine-readable. */
  datetime?: Date | string;
  href?: string;
  /** Muted text after the title: an employer, an institution. */
  where?: string;
  /** Mono line under the title saying whose work it was. */
  context?: string;
  /** One mono line under the title. */
  note?: string;
  summary?: string;
  tags?: string[];
  /** External artifacts: doi, code, repository, certificate. */
  links?: Record<string, string | undefined>;
  todo?: string;
  as?: 'h2' | 'h3' | 'h4' | 'p';
  dense?: boolean;
}

const {
  title,
  label,
  datetime,
  href,
  where,
  context,
  note,
  summary,
  tags = [],
  links = {},
  todo,
  as: Heading = 'h3',
  dense = false,
} = Astro.props;

const linkEntries = presentLinks(links);
const hasByline = Astro.slots.has('byline');
const showNote = note && note.trim().toLowerCase() !== label.trim().toLowerCase();

---

<article class:list={['entry', { 'entry-dense': dense, 'entry-linked': href }]}>
  <div class="entry-label">
    {datetime ? (
      <time datetime={typeof datetime === 'string' ? datetime : datetime.toISOString().slice(0, 10)}>{label}</time>
    ) : (
      <span>{label}</span>
    )}
  </div>
  <div class="entry-main">
    {/* Only the title is the link. CSS stretches the hit area over the row. */}
    <Heading class="entry-title">
      {href ? <a href={href}>{title}</a> : title}
      {where && <span class="entry-where"> · {where}</span>}
    </Heading>
    {hasByline && <p class="entry-byline"><slot name="byline" /></p>}
    {context && <p class="entry-note">{context}</p>}
    {showNote && <p class="entry-note">{note}</p>}
    {summary && <p class="entry-body">{summary}</p>}
    {tags.length > 0 && (
      <ul class="entry-tags">
        {tags.map((t) => <li>{t}</li>)}
      </ul>
    )}
    {linkEntries.length > 0 && (
      <ul class="entry-links">
        {linkEntries.map(([key, url]) => (
          <li>
            <a href={url} target="_blank" rel="noopener">{LINK_LABELS[key] ?? key}</a>
          </li>
        ))}
      </ul>
    )}
    {todo && SHOW_TODOS && <p class="entry-note"><Todo text={todo} /></p>}
  </div>
</article>
