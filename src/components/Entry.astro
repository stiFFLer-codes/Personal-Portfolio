---
// One row in any list on the site: papers, systems, jobs, study. Two
// columns: a mono margin on the left that says what stage the thing is at
// ("published", "archived") or when it happened ("Jan 2026 – now"); the
// content on the right. The last line of every row says how far it can be
// checked: the links if there are any, and the row's tally from the ledger.
//
// This is the only place list rows are described. Change the shape of a
// listing here and every page that lists anything follows.
import State from './State.astro';
import Todo from './Todo.astro';
import type { State as S } from '../ledger';

const LINK_LABELS: Record<string, string> = {
  repo: 'repository',
  live: 'live site',
  preprint: 'preprint',
  arxiv: 'arXiv',
  code: 'code',
  doi: 'doi',
  zenodo: 'zenodo',
  certificate: 'certificate',
};

interface Props {
  title: string;
  /** The margin word or date. */
  label: string;
  /** Set when `label` is a date, so it is machine-readable. */
  datetime?: Date | string;
  href?: string;
  /** Muted text after the title: an employer, an institution. */
  where?: string;
  /** Mono line under the title saying whose work it was. */
  context?: string;
  /** One mono line under the title. */
  note?: string;
  summary?: string;
  tags?: string[];
  /** External, checkable artifacts (doi, code, repository). */
  links?: Record<string, string | undefined>;
  /** The row's claims, from the ledger. Rendered as a tally by state. */
  ledger?: { state: S }[];
  /** For rows with no ledger of their own: a single state. */
  state?: S;
  todo?: string;
  as?: 'h2' | 'h3' | 'h4' | 'p';
  dense?: boolean;
}

const {
  title,
  label,
  datetime,
  href,
  where,
  context,
  note,
  summary,
  tags = [],
  links = {},
  ledger = [],
  state,
  todo,
  as: Heading = 'h3',
  dense = false,
} = Astro.props;

const linkEntries = Object.entries(links).filter(([, url]) => Boolean(url)) as [
  string,
  string,
][];
const hasByline = Astro.slots.has('byline');
const showNote = note && note.trim().toLowerCase() !== label.trim().toLowerCase();

const count = (s: S) => ledger.filter((l) => l.state === s).length;
const tally: [S, string][] = ledger.length
  ? (
      [
        ['checkable', `${count('checkable')} checkable`],
        ['word', `${count('word')} on my word`],
        ['open', `${count('open')} unresolved`],
      ] as [S, string][]
    ).filter(([s]) => count(s) > 0)
  : state
    ? [[state, state === 'checkable' ? 'checkable' : state === 'word' ? 'on my word' : 'unresolved']]
    : [];
---

<article class:list={['entry', { 'entry-dense': dense, 'entry-linked': href }]}>
  <div class="entry-label">
    {datetime ? (
      <time datetime={typeof datetime === 'string' ? datetime : datetime.toISOString().slice(0, 10)}>{label}</time>
    ) : (
      <span>{label}</span>
    )}
  </div>
  <div class="entry-main">
    {/* Only the title is the link. CSS stretches the hit area over the row. */}
    <Heading class="entry-title">
      {href ? <a href={href}>{title}</a> : title}
      {where && <span class="entry-where"> · {where}</span>}
    </Heading>
    {hasByline && <p class="entry-byline"><slot name="byline" /></p>}
    {context && <p class="entry-note">{context}</p>}
    {showNote && <p class="entry-note">{note}</p>}
    {summary && <p class="entry-body">{summary}</p>}
    {tags.length > 0 && (
      <ul class="entry-tags">
        {tags.map((t) => <li>{t}</li>)}
      </ul>
    )}
    {(tally.length > 0 || linkEntries.length > 0) && (
      <ul class="entry-links">
        {tally.map(([s, text]) => (
          <li><State state={s} label={text} /></li>
        ))}
        {linkEntries.map(([key, url]) => (
          <li>
            <a href={url} target="_blank" rel="noopener">{LINK_LABELS[key] ?? key}</a>
          </li>
        ))}
      </ul>
    )}
    {todo && <p class="entry-note"><Todo text={todo} /></p>}
  </div>
</article>
