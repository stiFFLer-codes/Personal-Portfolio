---
import { SITE } from '../site.config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/research', label: 'papers' },
  { href: '/projects', label: 'systems' },
  { href: '/writing', label: 'writing' },
  { href: '/travel', label: 'the north' },
];
// A detail page marks its section, so /research/three-voices lights "papers".
const current = (href: string) =>
  path === href ? 'page' : path.startsWith(`${href}/`) ? 'true' : undefined;
---

<nav class="site-nav" aria-label="Primary">
  <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>{SITE.name}</a>
  <div class="links">
    {links.map((l) => (
      <a href={l.href} aria-current={current(l.href)}>{l.label}</a>
    ))}
    <a class="nav-open" href="/unresolved" aria-current={current('/unresolved')}>
      <span class="mark mark-open" aria-hidden="true"></span>unresolved
    </a>
  </div>
</nav>
