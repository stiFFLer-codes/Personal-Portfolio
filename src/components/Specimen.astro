---
// One mounted photo in the field log: a hairline frame on a paper-raised mat,
// tilted a touch as if taped in, with a mono specimen label. Renders an
// optimized image when one is mounted, and an honest empty frame when none is
// — so a stop with no photo yet reads as a slot waiting to be filled, not a
// broken image. Tilt alternates by index and is static (a tilt is not a spin).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo?: { src: ImageMetadata; alt: string } | null;
  caption?: string;
  index?: number;
}
const { photo, caption, index = 0 } = Astro.props;
const tilt = index % 2 === 0 ? 'tilt-a' : 'tilt-b';
---

<figure class:list={['specimen', tilt]}>
  <div class="specimen-mat">
    {photo ? (
      <Image
        class="specimen-photo"
        src={photo.src}
        alt={photo.alt}
        widths={[260, 520]}
        sizes="(max-width: 34rem) 42vw, 15rem"
        loading="lazy"
      />
    ) : (
      <div class="specimen-empty" aria-hidden="true">
        <span class="mono">photo to be mounted</span>
      </div>
    )}
  </div>
  {caption && <figcaption class="specimen-caption mono">{caption}</figcaption>}
</figure>
