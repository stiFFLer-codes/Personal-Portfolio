---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';

const entries = (await getCollection('changelog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const lastLogDate = entries[0]?.data.date;

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base
  title="Log — Maitreya Sapariya"
  description="A running record of what's shipped, what's in progress, and what's just a note."
  lastLogDate={lastLogDate}
>
  <div class="container">
    <section class="hero">
      <p class="kicker reveal">log</p>
      <h1 class="reveal">Everything, roughly as it happened.</h1>
      <p class="lede reveal">
        Green entries shipped. Amber entries are in motion. Slate entries are just
        notes worth keeping. No entry gets rewritten after the fact to look better.
      </p>
    </section>

    <section class="section">
      <div class="rail">
        {entries.map((e) => (
          <Entry
            as="h2"
            title={e.data.title}
            status={e.data.tag}
            meta={dateFmt(e.data.date)}
            datetime={e.data.date}
            summary={e.body?.trim() || undefined}
          />
        ))}
      </div>
    </section>
  </div>
</Base>
