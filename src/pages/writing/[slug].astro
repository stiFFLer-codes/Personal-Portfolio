---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { day } from '../../format';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((p) => ({
    params: { slug: p.id },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} · Maitreya Sapariya`}
  description={post.data.summary}
>
  <div class="container">
    <section class="hero">
      <p class="kicker reveal"><a class="back" href="/writing">writing</a></p>
      <h1 class="reveal">{post.data.title}</h1>
      <p class="lede reveal">{post.data.summary}</p>
      {/* Same mono meta row the work pages use, minus the dot — a post has a
          date and tags, not a status. Reusing the class beats a second one
          that would be identical apart from its name. */}
      <p class="status-line reveal">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {day(post.data.date)}
        </time>
        {post.data.tags.length > 0 && <span>· {post.data.tags.join(', ')}</span>}
      </p>
    </section>

    <section class="section">
      <article class="prose">
        <Content />
      </article>
    </section>
  </div>
</Base>
