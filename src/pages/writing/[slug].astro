---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { year } from '../../format';

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
  return posts.map((p, i) => ({
    params: { slug: p.id },
    props: { post: p, next: posts[(i + 1) % posts.length] },
  }));
}

const { post, next } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} · Maitreya Sapariya`}
  description={post.data.summary}
>
  <div class="container post">
    <section class="page-head">
      <p class="kicker reveal"><a class="back" href="/writing">writing</a></p>
      <h1 class="post-title reveal">{post.data.title}</h1>
      <p class="lede reveal reveal-2">{post.data.summary}</p>
      <p class="status-line reveal reveal-2">
        <time datetime={year(post.data.date)}>{year(post.data.date)}</time>
        {post.data.tags.length > 0 && <span>· {post.data.tags.join(', ')}</span>}
      </p>
    </section>

    <section class:list={['section', { 'two-col': post.data.related.length > 0 }]}>
      <article class="prose">
        <Content />
      </article>
      {post.data.related.length > 0 && (
        <aside class="side" aria-labelledby="related-title">
          <h2 id="related-title">The work behind this post</h2>
          <ul>
            {post.data.related.map((r) => (
              <li class="side-item">
                <a class="go" href={r.href}>{r.label}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </section>

    <nav class="section next-post" aria-label="More writing">
      <p class="eyebrow">next</p>
      <p class="next-title"><a href={`/writing/${next.id}`}>{next.data.title}</a></p>
      <p class="lede">{next.data.summary}</p>
    </nav>
  </div>
</Base>
