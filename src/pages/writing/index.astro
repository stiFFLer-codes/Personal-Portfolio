---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { year } from '../../format';

const posts = (await getCollection('writing')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Writing · Maitreya Sapariya" description="Plain-language versions of the research, and a few things I looked up because I couldn’t stop wondering.">
  <div class="container">
    <section class="page-head">
      <p class="kicker reveal">writing</p>
      <h1 class="reveal">Writing.</h1>
      {/* Maitreya's sentence. */}
      <p class="lede reveal reveal-2">
        Plain-language versions of the research, and a few things I looked up
        because I couldn’t stop wondering.
      </p>
    </section>

    <section class="section">
      <ul class="posts">
        {posts.map((p) => (
          <li class="post-card">
            <h2><a href={`/writing/${p.id}`}>{p.data.title}</a></h2>
            <p>{p.data.summary}</p>
            <ul class="entry-tags">
              <li><time datetime={year(p.data.date)}>{year(p.data.date)}</time></li>
              {p.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
