---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { year } from '../../format';

// Sorted by `order`, not by date, and labelled by year only (see the writing
// schema). The reading order is an editorial call: strongest first.
const posts = (await getCollection('writing')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Writing · Maitreya Sapariya" description="Plain-language versions of the research, and a few things I looked up because I couldn’t stop wondering.">
  <div class="container">
    <section class="hero">
      <p class="kicker reveal">writing</p>
      <h1 class="reveal">Writing.</h1>
      <p class="lede reveal">
        Plain-language versions of the research, and a few things I looked up
        because I couldn’t stop wondering.
      </p>
    </section>

    <section class="section">
      <div class="rows">
        {posts.map((p) => (
          <Entry
            as="h2"
            href={`/writing/${p.id}`}
            title={p.data.title}
            label={year(p.data.date)}
            datetime={year(p.data.date)}
            summary={p.data.summary}
            tags={p.data.tags}
          />
        ))}
      </div>
    </section>
  </div>
</Base>
