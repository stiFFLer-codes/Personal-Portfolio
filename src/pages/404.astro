---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Maitreya Sapariya" description="That page does not exist.">
  <div class="container">
    <section class="page-head">
      <p class="kicker"><span class="mark mark-open" aria-hidden="true"></span> 404 · unresolved</p>
      {/* drafted by Fable */}
      <h1>This address couldn’t be resolved.</h1>
      <p class="lede">
        No guess at what you meant. The page may have moved, or it may never have been here.
      </p>
      <div class="cta-row">
        <a class="cta primary" href="/">go home</a>
        <a class="cta" href="/research">see the papers</a>
      </div>
    </section>
  </div>
</Base>
