    <section class="hero">
      <p class="kicker">404</p>
      <h1>That page doesn't exist.</h1>
      <p class="lede">It may have moved, or it may never have been here.</p>
      <div class="cta-row">
        <a class="cta primary" href="/">go home →</a>
        <a class="cta" href="/projects">see the projects →</a>
      </div>
    </section>
  </div>
</Base>
