---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import PaperByline from '../../components/PaperByline.astro';
import StageCounts from '../../components/StageCounts.astro';

const research = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Research · Maitreya Sapariya" description="A journal paper, a workshop paper, and two more that drive my work. Each one says what it couldn’t settle.">
  <div class="container">
    <section class="hero">
      <p class="kicker reveal">research</p>
      <h1 class="reveal">What I've written, and where it stands.</h1>
      <div class="reveal">
        <StageCounts items={research.map((r) => r.data)} noun={['paper', 'papers']} />
      </div>
      {/* Maitreya's sentence. Its counts are hand-written: update it when a
          paper changes stage or a fifth one lands (the tally above updates
          itself). */}
      <p class="lede reveal">
        A journal paper, a workshop paper, and two more that drive my work. Each
        one says what it couldn't settle.
      </p>
    </section>

    <section class="section">
      <div class="rows">
        {research.map((r) => (
          <Entry
            as="h2"
            href={`/research/${r.id}`}
            title={r.data.title}
            status={r.data.status}
            label={r.data.stage}
            summary={r.data.summary}
            links={r.data.links}
          >
            <PaperByline slot="byline" paper={r} />
          </Entry>
        ))}
      </div>
    </section>
  </div>
</Base>
