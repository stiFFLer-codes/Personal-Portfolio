---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import PaperByline from '../../components/PaperByline.astro';

const research = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Papers · Maitreya Sapariya" description="A journal paper, a workshop paper, and two more that drive my work. Each one says what it couldn’t settle.">
  <div class="container">
    <section class="page-head">
      <p class="kicker reveal">papers</p>
      <h1 class="reveal">What I've written, and where it stands.</h1>
      {/* Maitreya's sentence. Its counts are hand-written: update it when a
          fifth paper lands. */}
      <p class="lede reveal reveal-2">
        A journal paper, a workshop paper, and two more that drive my work. Each
        one says what it <span class="marked">couldn't settle.</span>
      </p>
    </section>

    <section class="section">
      <div class="rows">
        {research.map((r) => (
          <Entry
            as="h2"
            href={`/research/${r.id}`}
            title={r.data.title}
            label={r.data.stage}
            context={r.data.kind}
            summary={r.data.summary}
            links={r.data.links}
          >
            <PaperByline slot="byline" paper={r} />
          </Entry>
        ))}
      </div>
    </section>
  </div>
</Base>
