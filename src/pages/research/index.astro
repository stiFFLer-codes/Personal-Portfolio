---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import PaperByline from '../../components/PaperByline.astro';

const research = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Research · Maitreya Sapariya" description="In-progress and published research.">
  <div class="container">
    <section class="hero">
      <p class="kicker reveal">research</p>
      <h1 class="reveal">In-progress and published research.</h1>
    </section>

    <section class="section">
      <div class="rows">
        {research.map((r) => (
          <Entry
            as="h2"
            href={`/research/${r.id}`}
            title={r.data.title}
            status={r.data.status}
            label={r.data.stage}
            summary={r.data.summary}
            links={r.data.links}
          >
            <PaperByline slot="byline" paper={r} />
          </Entry>
        ))}
      </div>
    </section>
  </div>
</Base>
