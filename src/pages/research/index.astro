---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';

const research = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Research — Maitreya Sapariya" description="In-progress and published research.">
  <div class="container">
    <section class="hero">
      <p class="kicker reveal">research</p>
      <h1 class="reveal">In-progress and published research.</h1>
      <p class="lede reveal">
        Green means published here or on arXiv. Amber means the manuscript is in revision. The work stays honest about its actual status—no placeholder language.
      </p>
    </section>

    <section class="section">
      <div class="rail">
        {research.map((r) => (
          <Entry
            as="h2"
            href={`/research/${r.id}`}
            title={r.data.title}
            status={r.data.status}
            meta={r.data.status.replace('-', ' ')}
            summary={r.data.summary}
          />
        ))}
      </div>
    </section>
  </div>
</Base>
