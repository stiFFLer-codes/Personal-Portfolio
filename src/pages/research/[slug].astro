---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map((r) => ({
    params: { slug: r.id },
    props: { research: r },
  }));
}

const { research } = Astro.props;
const { Content } = await render(research);
---

<Base
  title={`${research.data.title} — Maitreya Sapariya`}
  description={research.data.summary}
>
  <div class="container">
    <section class="hero">
      <p class="kicker reveal"><a href="/research">← research</a></p>
      <h1 class="reveal">{research.data.title}</h1>
      <p class="lede reveal">{research.data.summary}</p>
      <span class={`status-pill ${research.data.status} reveal`}>
        {research.data.statusLabel}
      </span>
    </section>

    <section class="section prose">
      <Content />
    </section>
  </div>
</Base>
