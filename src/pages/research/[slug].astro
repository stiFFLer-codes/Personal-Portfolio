---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusDot from '../../components/StatusDot.astro';
import SourceLinks from '../../components/SourceLinks.astro';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map((r) => ({
    params: { slug: r.id },
    props: { research: r },
  }));
}

const { research } = Astro.props;
const { Content } = await render(research);
---

<Base
  title={`${research.data.title} — Maitreya Sapariya`}
  description={research.data.summary}
>
  <div class="container">
    <section class="hero">
      <p class="kicker reveal"><a href="/research">← research</a></p>
      <h1 class="reveal">{research.data.title}</h1>
      <p class="lede reveal">{research.data.summary}</p>
      <p class="status-line reveal">
        <StatusDot status={research.data.status} />
        {research.data.statusLabel}
        {research.data.venue && <span>· {research.data.venue}</span>}
      </p>
    </section>

    <section class="section">
      <article class="prose">
        <Content />
      </article>
      <SourceLinks links={research.data.links} />
    </section>
  </div>
</Base>
