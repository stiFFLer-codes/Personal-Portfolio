---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkPage from '../../components/WorkPage.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base
  title={`${project.data.title} · Maitreya Sapariya`}
  description={project.data.summary}
>
  <WorkPage
    back={{ href: '/projects', label: 'systems' }}
    meta={[project.data.kind ?? 'project', project.data.stage, project.data.context ?? '']}
    title={project.data.title}
    summary={project.data.summary}
    links={project.data.links}
    sourcesNote={project.data.sourcesNote}
    hasBody={Boolean(project.body?.trim())}
  >
    <p slot="byline" class="status-line reveal reveal-2">
      <span>{project.data.statusLabel}</span>
    </p>
    <Content />
    {project.data.stack.length > 0 && (
      <p class="entry-note" style="margin-top: var(--s-6)">built with: {project.data.stack.join(' · ')}</p>
    )}
  </WorkPage>
</Base>
