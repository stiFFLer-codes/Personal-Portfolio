---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Projects · Maitreya Sapariya" description="What I'm building, and what state it's actually in.">
  <div class="container">
    <section class="hero">
      <p class="kicker reveal">projects</p>
      <h1 class="reveal">What I'm building, and what state it's actually in.</h1>
      {/* TODO(markie): the first two sentences of this lede described the old
          dot legend ("green means it runs… slate means it's queued") and were
          cut when the legend changed: an archived prototype is not queued.
          Rewrite the lede if you want one longer than this. */}
      <p class="lede reveal">
        This page gets one new entry when a new project earns one, not before.
      </p>
    </section>

    <section class="section">
      <div class="rows">
        {projects.map((p) => (
          <Entry
            as="h2"
            href={`/projects/${p.id}`}
            title={p.data.title}
            status={p.data.status}
            label={p.data.stage}
            note={p.data.statusLabel}
            summary={p.data.summary}
            tags={p.data.stack}
          />
        ))}
      </div>
    </section>
  </div>
</Base>
