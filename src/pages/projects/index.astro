---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Systems · Maitreya Sapariya"
  description="Client work, an internship, and things I built anyway. Each one is labelled for what it is."
>
  <div class="container">
    <section class="page-head">
      <p class="kicker reveal">systems</p>
      <h1 class="reveal">What I'm building, and what state it's actually in.</h1>
      {/* Maitreya's sentences. */}
      <p class="lede reveal reveal-2">
        Client work, an internship, and things I built anyway. Each one is
        labelled for what it is.
      </p>
    </section>

    <section class="section">
      <div class="rows">
        {projects.map((p) => (
          <Entry
            as="h2"
            href={`/projects/${p.id}`}
            title={p.data.title}
            label={p.data.stage}
            context={[p.data.kind, p.data.context].filter(Boolean).join(' · ')}
            note={p.data.statusLabel}
            summary={p.data.summary}
            tags={p.data.stack}
            links={p.data.links}
          />
        ))}
      </div>
    </section>
  </div>
</Base>
