---
// The home page makes one argument, then keeps the record.
//
//   1. The thesis, the bio and the links.
//   2. Reported as found: six pieces of work, five of them shown as the answer
//      that sounded better, struck through, beside the one that was reported;
//      the sixth (CARTA) shows the paper's Fig. 1, redrawn.
//   3. The coin flip, playable.
//   4. The record: the same work as a CV lists it.
//   5. Writing, and the north.
//
// Copy: the thesis and the bio are Maitreya's. Everything else on this page
// was drafted by Fable from sentences already in the repo, and each block
// says so in a comment. Quotes in quotation marks are his, verbatim.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import PaperByline from '../components/PaperByline.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import CoinFlip from '../components/CoinFlip.astro';
import portrait from '../assets/maitreya.jpg';
import lecture from '../content/places/img/jyvaskyla-lecture.jpg';
import dawn from '../content/places/img/sandefjord-dawn.jpg';
import { SITE, EDUCATION, CERTIFICATIONS } from '../site.config';
import { span, year } from '../format';

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const research = (await getCollection('research')).sort(byOrder);
const experience = (await getCollection('experience')).sort(byOrder);
const projects = (await getCollection('projects')).sort(byOrder);
const writing = (await getCollection('writing')).sort(byOrder);
const places = await getCollection('places');

---

<Base title={SITE.title}>
  <div class="container">
    <section class="masthead">
      {/* Who and where, read from site.config.ts. The three labels are
          drafted by Claude. */}
      <dl class="masthead-meta reveal">
        <div>
          <dt>currently</dt>
          <dd>{SITE.jobTitle}</dd>
        </div>
        <div>
          <dt>at</dt>
          <dd>{SITE.employer}</dd>
        </div>
        <div>
          <dt>based in</dt>
          <dd>{SITE.location}</dd>
        </div>
      </dl>

      {/* The thesis and the bio on the left, the portrait beside them; on a
          phone the portrait sits between the two (grid areas in CSS). */}
      <div class="hero-grid">
        {/* Maitreya's line. */}
        <p class="thesis reveal reveal-2">
          I build software systems that report what they <mark>couldn’t resolve.</mark>
        </p>

        <Image
          class="portrait reveal reveal-2"
          src={portrait}
          alt="Maitreya Sapariya standing outdoors in a black blazer and glasses, smiling"
          widths={[360, 540, 720, 1080]}
          sizes="(max-width: 52rem) calc(100vw - 2.5rem), 21rem"
          loading="eager"
        />

        <div class="bio reveal reveal-3">
            {/* Maitreya's words. Agents fix typos only. */}
            <p>
              I’m a software engineer with a degree in AI and data science, so I work
              on both halves: the pipelines, and the models that run on them. My
              research is about the decisions inside those systems, at design time,
              before any labels exist, and at runtime, when the data can’t settle the
              answer. Two of my papers come at this through accessibility and AI ethics: who receives
              an answer, in what form, and whether they are told when the model is
              unsure.
            </p>
            <ProfileLinks />
            {/* drafted by Fable */}
            <p class="masthead-skip">
              <a class="go go-down" href="#record">Short on time? Skip to the record</a>
            </p>
        </div>
      </div>
    </section>

    {/* ---------------- Reported as found ---------------- */}
    <section class="section" aria-labelledby="found">
      {/* drafted by Fable */}
      <p class="eyebrow">reported as found</p>
      <h2 id="found" class="display">Each of these had a better-sounding answer available.</h2>
      <p class="section-lede">
        Struck through: the answer that sounds better. Under it: the one the work supports.
      </p>

      <ul class="wall">
        <li class="finding">
          <p class="finding-kind">Three Voices · dataset audit</p>
          <p class="finding-metric">macro-recall</p>
          <label class="flip">
            <input type="checkbox" checked />
            <code>df.drop_duplicates()</code>
          </label>
          <p class="finding-values">
            <span class="was"><span class="sr-only">With the duplicate rows left in: </span>0.859</span>
            <span class="is"><span class="sr-only">With them removed, and the figure reported: </span>0.580</span>
          </p>
          <p class="finding-body">
            <span class="flip-on">A public maternal-health dataset, just over a thousand rows, 561 of them exact
            copies. Same model, same cross-validation, one line of code.</span>
            <span class="flip-off">Switched off, the model is tested on rows it has already memorised. This is the
            number it gets for that.</span>
          </p>
          {/* Maitreya's sentence, from the post. */}
          <p class="finding-body finding-quote">
            “I would take an honest 0.580 over a shiny 0.859 that stops being true the second
            somebody checks my work.”
          </p>
          <p class="finding-foot"><a class="go" href="/writing/one-line-deleted-accuracy">One line of code deleted a third of my accuracy</a></p>
        </li>

        <li class="finding">
          <p class="finding-kind">Three Voices · submitted</p>
          <p class="finding-metric">the mother’s screen, on a near-tie</p>
          <p class="finding-values">
            <span class="was"><span class="sr-only">Not shown: </span>red</span>
            <span class="is is-amber"><span class="sr-only">Shown: </span>amber</span>
          </p>
          <p class="finding-body">
            The model gave one risk level 0.487 and the next 0.499. The clinician still sees
            both numbers. The red alarm is held back from the person least able to question it,
            and from nobody else. Amber is never green.
          </p>
          <p class="finding-foot"><a class="go" href="#coin-flip">Move the gap yourself</a></p>
        </li>

        <li class="finding">
          <p class="finding-kind">CARTA · published</p>
          {/* drafted by Claude */}
          <p class="finding-metric">one account, two phones</p>
          <figure class="finding-figure">
            {/* Redrawn from Fig. 1 of the paper, keeping only what reads at
                card size: the two fragments, the overlaps, failure and
                recovery. The full figure is on the paper's page. */}
            <svg viewBox="0 0 320 156" font-size="11" role="img" aria-labelledby="tcf-title tcf-desc">
              <title id="tcf-title">One account's chat history, split across two phones</title>
              <desc id="tcf-desc">
                A timeline redrawn from Fig. 1 of the paper. The primary phone's history, F1, runs
                until the failure and then pauses. The secondary phone's history, F2, runs from just
                before the failure to just after the recovery. At the recovery F1 resumes. The two
                stretches where both phones hold the same time are hatched.
              </desc>
              <defs>
                <pattern id="tcf-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <line class="tcf-hatch-line" x1="0" y1="0" x2="0" y2="5" />
                </pattern>
              </defs>
              <rect class="tcf-hatch" x="84" y="62" width="28" height="18" />
              <rect class="tcf-hatch" x="208" y="62" width="28" height="18" />
              <rect class="tcf-f2" x="84" y="38" width="152" height="24" rx="3" />
              <text class="tcf-label" x="160" y="54" text-anchor="middle">F<tspan font-size="8" dy="3">2</tspan><tspan dy="-3"> secondary</tspan></text>
              <rect class="tcf-f1" x="8" y="80" width="104" height="24" rx="3" />
              <text class="tcf-label" x="60" y="96" text-anchor="middle">F<tspan font-size="8" dy="3">1</tspan><tspan dy="-3"> primary</tspan></text>
              <path class="tcf-paused" d="M112 92H208" />
              <rect class="tcf-f1" x="208" y="80" width="104" height="24" rx="3" />
              <text class="tcf-label" x="260" y="96" text-anchor="middle">F<tspan font-size="8" dy="3">1</tspan></text>
              <path class="tcf-axis" d="M8 124H312M306 120l6 4-6 4M112 119v10M208 119v10" />
              <text class="tcf-note" font-size="10" x="112" y="145" text-anchor="middle">failure</text>
              <text class="tcf-note" font-size="10" x="208" y="145" text-anchor="middle">recovery</text>
              <text class="tcf-note" font-size="10" x="312" y="145" text-anchor="end">time</text>
            </svg>
            <figcaption>Redrawn from Fig. 1 of the paper</figcaption>
          </figure>
          {/* Maitreya's words, from the paper's introduction. */}
          <p class="finding-body finding-quote">
            “The owner has lost the history without losing a message. It is a loss by
            non-union: both halves survive, and what is missing is the join.”
          </p>
          {/* drafted by Claude, from the paper's abstract */}
          <p class="finding-body">
            CARTA rebuilds one archive from the pieces, with a report of where each record
            came from.
          </p>
          <p class="finding-foot"><a class="go" href="/research/carta-when-chats-split-apart">When chats split apart</a></p>
        </li>

        <li class="finding">
          <p class="finding-kind">Prediction is not selection · preprint</p>
          <p class="finding-metric">which mechanism to build</p>
          <p class="finding-values">
            <span class="was"><span class="sr-only">Not found: </span>a winner</span>
            <span class="is is-words"><span class="sr-only">Reported: </span>Inconclusive, twice</span>
          </p>
          <p class="finding-body">
            Hypotheses frozen at a commit hash before any accuracy existed. Pooled over seven
            datasets the two mechanisms score 0.8244 and 0.8294. Neither hypothesis cleared the
            margin fixed in advance, and the paper says so.
          </p>
          <p class="finding-foot"><a class="go" href="/research/prediction-is-not-selection">The pre-registered study</a></p>
        </li>

        <li class="finding">
          <p class="finding-kind">eRESI · in production</p>
          <p class="finding-metric">when retrieval finds nothing</p>
          <p class="finding-values">
            <span class="was"><span class="sr-only">Not given: </span>a best guess</span>
            <span class="is is-words"><span class="sr-only">Given: </span>a human underwriter</span>
          </p>
          <p class="finding-body">
            A question-and-answer assistant over a mortgage lender’s guideline PDFs. Every answer
            links to the sentence it came from. With nothing to cite, it returns a fixed reply
            that sends the user to a person.
          </p>
          <p class="finding-foot"><a class="go" href="/projects/mortgage-knowledge-assistant">The case study, and what I’d change</a></p>
        </li>

        <li class="finding">
          <p class="finding-kind">Amazon India sales analysis · internship</p>
          <p class="finding-metric">revenue, March to June 2022</p>
          <p class="finding-values">
            <span class="was"><span class="sr-only">Gross order value: </span><span class="cur">₹</span>78.59M</span>
            <span class="is"><span class="sr-only">Realised revenue: </span><span class="cur">₹</span>70.28M</span>
          </p>
          <p class="finding-body">
            Gross order value counts cancelled, returned and failed lines. Take them out and
            <span class="rs">₹</span>8.31M goes with them, 10.6% of the gross figure.
          </p>
          <p class="finding-foot"><a class="go" href="/projects/amazon-sales-analysis">The analysis, and the 959 rows I couldn’t classify</a></p>
        </li>
      </ul>
    </section>

    {/* ---------------- The coin flip ---------------- */}
    <section class="section" id="coin-flip" aria-labelledby="coin-flip-title">
      <div class="demo-intro">
        <div>
          <p class="eyebrow">try it</p>
          {/* The title of Maitreya's post. */}
          <h2 id="coin-flip-title">A coin flip should not look like a red light.</h2>
        </div>
        {/* Maitreya's words, from the post. */}
        <blockquote class="pull">
          <p>
            A model I built once split a case almost exactly down the middle. It gave one risk
            level 0.487 and the next level up 0.499. That is a gap of 0.012. A coin flip with
            extra steps.
          </p>
          <footer>
            from <a href="/writing/coin-flip-red-light">the post</a> and the paper,{' '}
            <a href="/research/three-voices">Three Voices</a>
          </footer>
        </blockquote>
      </div>
      <CoinFlip />
    </section>

    {/* ---------------- The record ---------------- */}
    <section class="section" aria-labelledby="record">
      {/* drafted by Fable */}
      <p class="eyebrow">the record</p>
      {/* drafted by Claude */}
      <h2 id="record">Papers, systems, work and study.</h2>

      <div class="record" style="margin-top: var(--s-7)">
        <div>
          <h3 id="papers">Papers and preprints</h3>
          <div class="rows">
            {research.map((r) => (
              <Entry
                as="h4"
                href={`/research/${r.id}`}
                title={r.data.title}
                label={r.data.stage}
                links={r.data.links}
              >
                <PaperByline slot="byline" paper={r} />
              </Entry>
            ))}
          </div>
        </div>

        <div>
          <h3 id="systems">Systems and analyses</h3>
          <div class="rows">
            {projects.map((p) => (
              <Entry
                as="h4"
                href={`/projects/${p.id}`}
                title={p.data.title}
                label={p.data.stage}
                context={p.data.context}
                summary={p.data.summary}
                links={p.data.links}
              />
            ))}
          </div>
        </div>

        <div class="record-pair">
          <div>
            <h3 id="work">Work</h3>
            <div class="rows">
              {experience.map((e) => (
                <Entry
                  dense
                  as="h4"
                  href={e.data.project && `/projects/${e.data.project.id}`}
                  title={e.data.role}
                  where={[e.data.company, e.data.location].filter(Boolean).join(', ')}
                  label={span(e.data.start, e.data.end)}
                  note={e.data.note}
                />
              ))}
            </div>
          </div>

          <div>
            <h3 id="study">Study</h3>
            <div class="rows">
              {[...EDUCATION, ...CERTIFICATIONS].map((c) => (
                <Entry
                  dense
                  as="h4"
                  href={c.href}
                  title={c.title}
                  where={c.where}
                  note={c.note}
                  label={c.date}
                  links={{ certificate: c.proof }}
                  todo={c.proof ? undefined : c.todo}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ---------------- Writing ---------------- */}
    <section class="section" aria-labelledby="writing">
      <div class="section-head">
        <div>
          <p class="eyebrow">writing</p>
          {/* drafted by Fable */}
          <h2 id="writing">Where I sound like myself.</h2>
        </div>
      </div>
      <ul class="posts">
        {writing.map((w) => (
          <li class="post-card">
            <h3><a href={`/writing/${w.id}`}>{w.data.title}</a></h3>
            <p>{w.data.summary}</p>
            <ul class="entry-tags">
              <li><time datetime={year(w.data.date)}>{year(w.data.date)}</time></li>
              {w.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </section>

    {/* ---------------- The north ---------------- */}
    <section class="section" aria-labelledby="north">
      <div class="north">
        <div>
          <p class="eyebrow">the north · august 2025</p>
          <p class="north-figure">
            <b>40%</b>
            <span>of each lecture, maybe, understood in the room</span>
          </p>
          {/* The title of Maitreya's post. */}
          <h2 id="north">I flew to Finland to study something I couldn’t define.</h2>
          {/* Maitreya's words, from the post. */}
          <blockquote class="pull" style="margin: var(--s-5) 0">
            <p>
              The other sixty percent I copied down word for word so I could decode it that
              night in my room. That copying-and-decoding turned out to be the real skill of
              the trip.
            </p>
          </blockquote>
          {/* drafted by Fable */}
          <p class="section-lede" style="font-size: var(--t-base)">
            The 34th Jyväskylä Summer School and the solo trip around it: {places.length} stops on the
            map, five countries. It is the same habit as the rest of this page, turned on
            myself: say what you don’t know yet, and stay in the chair.
          </p>
          <p><a class="go" href="/travel">The map and the field log</a></p>
        </div>
        <div class="north-photos">
          <Image
            src={lecture}
            alt="A summer-school lecture in progress: a laptop and notebook in the foreground, 'Machine learning and stochastic control' on the projector screen."
            widths={[400, 800]}
            sizes="(max-width: 52rem) 55vw, 24rem"
          />
          <Image
            src={dawn}
            alt="A pink and blue dawn sky over an empty roadside and fields near Sandefjord."
            widths={[320, 640]}
            sizes="(max-width: 52rem) 40vw, 18rem"
          />
        </div>
      </div>
    </section>
  </div>

</Base>
