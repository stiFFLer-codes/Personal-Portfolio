---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TravelMap from '../../components/TravelMap.astro';
import Specimen from '../../components/Specimen.astro';

const places = (await getCollection('places')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Travel — Maitreya Sapariya"
  description="A map of the August 2025 Nordic and Baltic trip, built around the 34th Jyväskylä Summer School."
>
  <div class="container">
    <section class="hero">
      <p class="kicker reveal">travel</p>
      <h1 class="reveal">The trip that made Europe stop being a maybe.</h1>
      <p class="lede reveal">
        One summer school in Finland, five countries solo, and more trains
        than I can count. I went to learn machine learning and stochastic
        control. I came back certain about where I want to do the rest.
      </p>
    </section>
  </div>

  <!-- The map breaks out of the text column into a wide atlas plate, with the
       cartographic furniture set as marginalia in the reclaimed side space. -->
  <div class="travel-atlas reveal">
    <div class="atlas-map">
      <TravelMap places={places} />
    </div>

    <aside class="atlas-margin">
      <div class="atlas-title">
        <span class="atlas-title-main mono">THE NORTH</span>
        <span class="atlas-title-sub mono">a field survey · august '25</span>
      </div>

      <p class="atlas-summary mono">solo · {places.length} stops · 5 countries</p>

      <ul class="atlas-legend mono">
        <li><span class="dot dot-shipped" aria-hidden="true"></span> anchor — summer school</li>
        <li><span class="dot dot-note" aria-hidden="true"></span> stop</li>
        <li><span class="atlas-legend-line" aria-hidden="true"></span> the route, in travel order</li>
      </ul>

      <nav class="atlas-index mono" aria-label="Stops">
        <ol>
          {places.map((p) => (
            <li>
              <a href={`#stop-${p.id}`}>
                <span class="atlas-index-num">{String(p.data.order).padStart(2, '0')}</span>
                <span class="atlas-index-name">{p.data.name}</span>
                <span
                  class:list={['dot', p.data.anchor ? 'dot-shipped' : 'dot-note']}
                  aria-hidden="true"
                ></span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <p class="atlas-hint mono">
        Hover or focus a stop to read its note; select one to jump to its
        photos below.
      </p>
    </aside>
  </div>

  <div class="container">
    <section class="section">
      <div class="section-head">
        <h2>Field log</h2>
        <span class="see-all">{places.length} stops · 5 countries</span>
      </div>

      <ol class="field-log">
        {places.map((p) => (
          <li class="field-entry" id={`stop-${p.id}`}>
            <span
              class:list={['dot', p.data.anchor ? 'dot-shipped' : 'dot-note']}
              aria-hidden="true"
            ></span>
            <div class="field-head">
              <h3 class="field-name">
                {p.data.name}
                <span class="field-order mono">
                  {String(p.data.order).padStart(2, '0')}
                </span>
              </h3>
              <p class="field-meta mono">
                {p.data.country} · {p.data.dateLabel}
                {p.data.anchor && ' · anchor'}
              </p>
            </div>
            <p class="field-blurb">{p.data.blurb}</p>
            {p.data.source && (
              <a
                class="field-source mono"
                href={p.data.source.href}
                target="_blank"
                rel="noopener"
              >
                {p.data.source.label} ↗
              </a>
            )}
            <div class="specimen-row">
              {(p.data.photos.length ? p.data.photos : [null]).map((ph, i) => (
                <Specimen photo={ph} index={i} />
              ))}
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>
